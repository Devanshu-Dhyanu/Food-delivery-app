# Cashfree Payment Gateway Configuration
# Copy this to .env.local and fill in your actual credentials

# Cashfree API Credentials
VITE_CASHFREE_CLIENT_ID=YOUR_CASHFREE_CLIENT_ID
VITE_CASHFREE_CLIENT_SECRET=YOUR_CASHFREE_CLIENT_SECRET
VITE_CASHFREE_ENVIRONMENT=sandbox

# Supabase Configuration (already existing)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Agora Voice Calling
# App ID can be exposed to the client.
VITE_AGORA_APP_ID=YOUR_AGORA_APP_ID

# Server-only secret for /api/agora/token
AGORA_APP_ID=YOUR_AGORA_APP_ID
AGORA_APP_CERTIFICATE=YOUR_AGORA_APP_CERTIFICATE

# Cloudflare Turnstile
# Site key can be exposed to the client, secret key must stay server-only.
VITE_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# Payment Callback URLs
VITE_PAYMENT_SUCCESS_REDIRECT=http://localhost:5173/payment/success
VITE_PAYMENT_FAILURE_REDIRECT=http://localhost:5173/payment/failure
VITE_PAYMENT_WEBHOOK_URL=http://localhost:5173/api/payment/webhook
